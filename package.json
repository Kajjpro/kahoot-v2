{
  "name": "dash-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Dash — a live quiz race. Host builds a quiz, players join with a code, fastest right answer wins.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/app --ignore ./src/components --ignore ./src/lib server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-engine.ts",
    "sim": "tsx scripts/simulate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
